    {
      "name": "Security Tests",
      "item": [
        {
          "name": "NoSQL Injection Attempt – Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 or 401 (sanitised input)', () => {",
                  "  pm.expect([400, 401]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Does not expose DB error', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(JSON.stringify(body)).to.not.include('MongoError');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('$where');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": { \"$gt\": \"\" },\n  \"password\": { \"$gt\": \"\" }\n}"
            }
          }
