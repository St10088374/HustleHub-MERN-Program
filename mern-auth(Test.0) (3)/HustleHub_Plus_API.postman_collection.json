{
  "info": {
    "name": "HustleHub+ API Tests",
    "_postman_id": "hustlehub-collection-v2",
    "description": "Postman collection for HustleHub+ API – Part 2. Covers authentication, gig management, bookings, and transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "client_email", "value": "", "type": "string" },
    { "key": "client_token", "value": "", "type": "string" },
    { "key": "freelancer_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "gig_id", "value": "", "type": "string" },
    { "key": "booking_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register – Client",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "const email = `testclient_${ts}@example.com`;",
                  "pm.collectionVariables.set('client_email', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.collectionVariables.set('client_token', body.token);",
                  "});",
                  "pm.test('User role is client', () => {",
                  "  pm.expect(pm.response.json().user.role).to.equal('client');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Client\",\n  \"email\": \"{{client_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"client\"\n}"
            }
          }
        },
        {
          "name": "Register – Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.collectionVariables.set('freelancer_token', body.token);",
                  "});",
                  "pm.test('User role is freelancer', () => {",
                  "  pm.expect(pm.response.json().user.role).to.equal('freelancer');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Freelancer\",\n  \"email\": \"testfreelancer_{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"freelancer\"\n}"
            }
          }
        },
        {
          "name": "Login – Client",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.collectionVariables.get('client_email');",
                  "if (!email) { throw new Error('client_email is not set. Run Register – Client first.'); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns token', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login – Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error message present', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('message');",
                  "});",
                  "pm.test('No token in error response', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns user object', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/user",
            "header": [{ "key": "Authorization", "value": "Bearer {{client_token}}" }]
          }
        },
        {
          "name": "Protected Route – No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Unauthorized message', () => {",
                  "  pm.expect(pm.response.json().message).to.include('Not authorized');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/user",
            "header": []
          }
        }
      ]
    },
